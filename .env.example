# Server-only Gmail SMTP configuration for the final CTA form.
# Never commit a real password. GMAIL_APP_PASSWORD is a Google App Password,
# not the normal Gmail account password.
GMAIL_USER=crestionlabs@gmail.com
GMAIL_APP_PASSWORD=
CONTACT_TO_EMAIL=crestionlabs@gmail.com

# Supabase public client configuration. Only the URL and publishable key belong here.
# Never put the sb_secret_... / service-role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only production handoff. The portal posts one signed request to this
# endpoint; the production backend updates project status, activity and worlds.
# For the reconstruction engine this is its intake route, e.g.
# http://127.0.0.1:8002/intake/requests with the engine holding the same secret.
PRODUCTION_BACKEND_URL=
PRODUCTION_BACKEND_SECRET=

# Server-only. Needed for the studio site's "Send to client" action, which
# records a finished world against a project without a client session present,
# and for resolving shared and embedded walkthrough links.
# In Supabase this is Settings -> API Keys -> Secret keys (sb_secret_...); the
# legacy service_role key also works but retires in early 2027. It bypasses row
# level security entirely: never expose it to the browser, never prefix it with
# NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Absolute public origin used to build the shareable walkthrough link and the
# embed code handed to clients, e.g. https://crestionlabs.vercel.app
# Falls back to the request origin, which is correct in development.
SITE_URL=
