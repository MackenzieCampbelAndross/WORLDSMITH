# Server-only Gmail SMTP configuration for the final CTA form.
# Never commit a real password. GMAIL_APP_PASSWORD is a Google App Password,
# not the normal Gmail account password.
GMAIL_USER=crestionlabs@gmail.com
GMAIL_APP_PASSWORD=
CONTACT_TO_EMAIL=crestionlabs@gmail.com

# Supabase public client configuration. Only the URL and publishable key belong here.
# Never put the sb_secret_... / service-role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
